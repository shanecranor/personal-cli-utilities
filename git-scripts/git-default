#!/usr/bin/env bash
set -euo pipefail

print_only=false
remote=""
update_remote_head=false

for argument in "$@"; do
  case "$argument" in
    --print-only|-p)
      print_only=true
      ;;
    --help|-h)
      printf 'Usage: git default [--print-only|-p] [remote]\n'
      exit 0
      ;;
    --)
      printf 'git default: unexpected end-of-options marker\n' >&2
      exit 2
      ;;
    -*)
      printf "git default: unknown option '%s'\n" "$argument" >&2
      exit 2
      ;;
    *)
      if [[ -n "$remote" ]]; then
        printf "git default: multiple remotes provided ('%s' and '%s')\n" "$remote" "$argument" >&2
        exit 2
      fi
      remote="$argument"
      ;;
  esac
done

remote="${remote:-origin}"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "git default: not a git repository" >&2
  exit 1
fi

default_branch="$(
  git ls-remote --symref "$remote" HEAD 2>/dev/null |
    awk '$1 == "ref:" && $3 == "HEAD" { sub("^refs/heads/", "", $2); print $2; exit }' ||
    true
)"

if [[ -n "$default_branch" ]]; then
  update_remote_head=true
  default_ref="$remote/$default_branch"
else
  default_ref="$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
fi

if [[ -z "$default_ref" ]] && command -v gh >/dev/null 2>&1; then
  remote_url="$(git remote get-url "$remote" 2>/dev/null || true)"
  gh_default_branch="$(gh repo view "$remote_url" --json defaultBranchRef --jq '.defaultBranchRef.name' 2>/dev/null || true)"
  if [[ -n "$gh_default_branch" ]]; then
    update_remote_head=true
    default_ref="$remote/$gh_default_branch"
  fi
fi

if [[ -z "$default_ref" ]]; then
  default_branch="$(git remote show "$remote" 2>/dev/null | awk '/HEAD branch/ {print $NF; exit}' || true)"
  if [[ -n "$default_branch" ]]; then
    default_ref="$remote/$default_branch"
  fi
fi

branch="${default_ref#"$remote/"}"

if [[ -z "$branch" || "$branch" == "$default_ref" ]]; then
  echo "git default: could not determine default branch for remote '$remote'" >&2
  exit 1
fi

if [[ "$print_only" == true ]]; then
  printf '%s\n' "$branch"
  exit 0
fi

if [[ "$update_remote_head" == true ]]; then
  git remote set-head "$remote" "$branch" >/dev/null 2>&1 || true
fi

if git show-ref --verify --quiet "refs/heads/$branch"; then
  git checkout "$branch"
elif git show-ref --verify --quiet "refs/remotes/$remote/$branch"; then
  git checkout --track "$remote/$branch"
else
  git checkout "$branch"
fi
